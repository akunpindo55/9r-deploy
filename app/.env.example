# Optional provider OAuth credentials. Leave unset unless enabling these login flows.

# Gemini and Gemini CLI OAuth client
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=

# Antigravity OAuth client
ANTIGRAVITY_OAUTH_CLIENT_ID=
ANTIGRAVITY_OAUTH_CLIENT_SECRET=

# Windsurf Firebase sign-in API key
WINDSURF_FIREBASE_API_KEY=
